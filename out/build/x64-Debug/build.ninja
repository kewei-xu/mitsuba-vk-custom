build Debug\png-mitsuba.dll ext\libpng\png-mitsuba.lib: C_SHARED_LIBRARY_LINKER__png_Debug ext\libpng\CMakeFiles\png.dir\png.c.obj ext\libpng\CMakeFiles\png.dir\pngerror.c.obj ext\libpng\CMakeFiles\png.dir\pngget.c.obj ext\libpng\CMakeFiles\png.dir\pngmem.c.obj ext\libpng\CMakeFiles\png.dir\pngpread.c.obj ext\libpng\CMakeFiles\png.dir\pngread.c.obj ext\libpng\CMakeFiles\png.dir\pngrio.c.obj ext\libpng\CMakeFiles\png.dir\pngrtran.c.obj ext\libpng\CMakeFiles\png.dir\pngrutil.c.obj ext\libpng\CMakeFiles\png.dir\pngset.c.obj ext\libpng\CMakeFiles\png.dir\pngtrans.c.obj ext\libpng\CMakeFiles\png.dir\pngwio.c.obj ext\libpng\CMakeFiles\png.dir\pngwrite.c.obj ext\libpng\CMakeFiles\png.dir\pngwtran.c.obj ext\libpng\CMakeFiles\png.dir\pngwutil.c.obj ext\libpng\CMakeFiles\png.dir\intel\intel_init.c.obj ext\libpng\CMakeFiles\png.dir\intel\filter_sse2_intrinsics.c.obj | ext\zlib\zlib.lib || Debug\zlib1.dll ext\libpng\png_genfiles
  LANGUAGE_COMPILE_FLAGS = /DWIN32 /D_WINDOWS /Zi /Ob0 /Od /RTC1 -MDd
  LINK_FLAGS = /machine:x64 /debug /INCREMENTAL
  LINK_LIBRARIES = ext\zlib\zlib.lib  kernel32.lib user32.lib gdi32.lib winspool.lib shell32.lib ole32.lib oleaut32.lib uuid.lib comdlg32.lib advapi32.lib
  OBJECT_DIR = ext\libpng\CMakeFiles\png.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  RESTAT = 1
  TARGET_COMPILE_PDB = ext\libpng\CMakeFiles\png.dir\
  TARGET_FILE = Debug\png-mitsuba.dll
  TARGET_IMPLIB = ext\libpng\png-mitsuba.lib
  TARGET_PDB = Debug\png-mitsuba.pdb


