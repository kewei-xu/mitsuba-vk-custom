  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D E:\THESE\Code\mitsuba-3.7.1\mitsuba3\out\build\x64-Debug && "C:\Program Files\Microsoft Visual Studio\2022\Community\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cpack.exe" --config ./CPackConfig.cmake"
